<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151515"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Header Token Row -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLOCKIT TIMER"
        android:textColor="#666666"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="4dp" />

    <!-- Core Interactive Timer Adjuster Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="6dp">

        <!-- Decrement Vector Panel - Fixed text alignment via gravity TextView conversion -->
        <TextView
            android:id="@+id/btn_widget_minus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="-"
            android:textColor="#FFFFFF"
            android:background="#2A2A2A"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true" />

        <!-- Duration Node View - Fixed line wrap behavior via singleLine lock bounds -->
        <TextView
            android:id="@+id/txt_widget_duration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="45m"
            android:textColor="#EED2C2"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="none" />

        <!-- Increment Vector Panel - Fixed text alignment via gravity TextView conversion -->
        <TextView
            android:id="@+id/btn_widget_plus"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:background="#2A2A2A"
            android:textStyle="bold"
            android:textSize="20sp"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true" />

    </LinearLayout>

    <!-- Main Action Core Tracker Button Block -->
    <Button
        android:id="@+id/btn_widget_play"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="START FOCUS"
        android:textColor="#000000"
        android:backgroundTint="#EED2C2"
        android:textSize="12sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:padding="0dp" />

    <!-- Compact Dynamic Reels Blocking Management Strip (Fixed vertical container layout blowout) -->
    <LinearLayout
        android:id="@+id/layout_widget_reels"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="4dp"
        android:background="#1E1E1E"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BLOCK REELS"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1" />

        <!-- Compact Trigger node wrapper to protect container bounds spacing constraints safely -->
        <Button
            android:id="@+id/btn_widget_reels_toggle"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:text="OFF"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2A2A2A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>